+ * GNU General Public License for more details:
+ *
+ * Plugin for the modem proxy samsungipcd (Samsung IPC modems, e.g. Shannon).
+ * Modelled on the MBM plugin.
+ */
+
+#include <string.h>
+#include <gmodule.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-plugin-common.h"
+#include "mm-broadband-modem-samsungipcd.h"
+
+#define MM_TYPE_PLUGIN_SAMSUNGIPCD mm_plugin_samsungipcd_get_type ()
+MM_DEFINE_PLUGIN (SAMSUNGIPCD, samsungipcd, Samsungipcd)
+
+/*****************************************************************************/
+
+static MMBaseModem *
+create_modem (MMPlugin     *self,
+              const gchar  *uid,
+              const gchar  *physdev,
+              const gchar **drivers,
+              guint16       vendor,
+              guint16       product,
+              guint16       subsystem_vendor,
+              guint16       subsystem_device,
+              GList        *probes,
+              GError      **error)
+{
+    return MM_BASE_MODEM (mm_broadband_modem_samsungipcd_new (uid,
+                                                              physdev,
+                                                              drivers,
+                                                              mm_plugin_get_name (self),
+                                                              vendor,
+                                                              product));
+}
+
+/*****************************************************************************/
+
+MM_PLUGIN_NAMED_CREATOR_SCOPE MMPlugin *
+mm_plugin_create_samsungipcd (void)
+{
+    /* The ports are not recognised by vendor or product (they are virtual
+     * ttys plus the modem's rmnet interface), a udev rule has to tag them. */
+    static const gchar *subsystems[] = { "tty", "net", NULL };
+    static const gchar *udev_tags[] = {
+        "ID_MM_SAMSUNGIPCD",
+        NULL
+    };
+
+    return MM_PLUGIN (
+        g_object_new (MM_TYPE_PLUGIN_SAMSUNGIPCD,
+                      MM_PLUGIN_NAME,               MM_MODULE_NAME,
+                      MM_PLUGIN_ALLOWED_SUBSYSTEMS, subsystems,
+                      MM_PLUGIN_ALLOWED_UDEV_TAGS,  udev_tags,
+                      MM_PLUGIN_ALLOWED_AT,         TRUE,
+                      /* The ports are virtual and have no kernel driver. Without
+                       * these three the port check would insist on finding a driver
+                       * name and filter every port. Nothing here is a QMI, MBIM or
+                       * XMM RPC modem, the udev tag decides which ports reach this
+                       * plugin. */
+                      MM_PLUGIN_ALLOWED_QMI,        TRUE,
+                      MM_PLUGIN_ALLOWED_MBIM,       TRUE,
+                      MM_PLUGIN_ALLOWED_XMMRPC,     TRUE,
+                      NULL));
+}
+
+static void
+mm_plugin_samsungipcd_init (MMPluginSamsungipcd *self)
+{
+}
+
+static void
+mm_plugin_samsungipcd_class_init (MMPluginSamsungipcdClass *klass)
+{
+    MMPluginClass *plugin_class = MM_PLUGIN_CLASS (klass);
+
+    plugin_class->create_modem = create_modem;
+}
