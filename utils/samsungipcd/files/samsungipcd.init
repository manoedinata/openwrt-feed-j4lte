#!/bin/sh /etc/rc.common
# Samsung IPC modem daemon: boots the modem and serves its AT port to
# ModemManager (started before it, which is START=70).

START=60
STOP=80
USE_PROCD=1

# block device of the partition with the given GPT name
part_by_name() {
	local u
	for u in /sys/class/block/*/uevent; do
		grep -qx "PARTNAME=$1" "$u" && { echo "/dev/$(basename "$(dirname "$u")")"; return 0; }
	done
	return 1
}

start_service() {
	local efs radio

	# the modem boot reads its NV data from /efs (read-only, never rw)
	if ! grep -q ' /efs ' /proc/mounts; then
		efs=$(part_by_name EFS) && mkdir -p /efs && mount -t ext4 -o ro "$efs" /efs
	fi

	# libsamsung-ipc opens the modem image by the udev name, which OpenWrt lacks
	if [ ! -e /dev/disk/by-partlabel/RADIO ]; then
		radio=$(part_by_name RADIO) && mkdir -p /dev/disk/by-partlabel && \
			ln -sf "$radio" /dev/disk/by-partlabel/RADIO
	fi

	procd_open_instance
	procd_set_param command /usr/libexec/samsungipcd-run
	# the daemon exits when the modem crashes; a restart reboots the modem
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
