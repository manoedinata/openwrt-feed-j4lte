#!/bin/sh
# Runs samsungipcd on the legacy pty /dev/ptyp0 and tells ModemManager about
# its ports (ttyp0 for AT, rmnet0 for data) once the daemon has the pty open:
# ModemManager cannot open the slave before the master is open, and the
# hotplug scripts skip virtual devices. When the daemon exits (the modem
# crashed) the ports are withdrawn again, so that ModemManager drops the
# stale modem, and procd restarts us.

. /usr/share/ModemManager/modemmanager.common 2>/dev/null
cache="${MODEMMANAGER_EVENTS_CACHE:-/var/run/modemmanager/events.cache}"
ports="ttyp0,tty rmnet0,net"

# Same cache as the ModemManager hotplug scripts: the ModemManager wrapper
# replays it when it starts after us.
report() {
	local action=$1 p name subsystem
	mkdir -m 0755 -p "${cache%/*}"
	for p in $ports; do
		name=${p%,*}; subsystem=${p#*,}
		if [ "$action" = add ]; then
			grep -qs "$name,$subsystem" "$cache" || \
				echo "add,$name,$subsystem,/sys/class/$subsystem/$name" >> "$cache"
		else
			sed -i "/$name,$subsystem/d" "$cache" 2>/dev/null
		fi
		# not ModemManager's pidfile: its init does not create the
		# directory for it, so on a boot without modem hotplug events
		# there is none
		pidof ModemManager >/dev/null && \
			mmcli --report-kernel-event="action=$action,name=$name,subsystem=$subsystem" >/dev/null 2>&1
	done
}

stdbuf -oL -eL /usr/sbin/samsungipcd /dev/ptyp0 &
pid=$!
trap 'kill $pid 2>/dev/null' TERM INT

# the modem boot comes first; the pty is opened after it (up to 90 s)
i=0
while [ $i -lt 90 ]; do
	ls -l /proc/$pid/fd 2>/dev/null | grep -q '/dev/ptyp0$' && { report add; break; }
	kill -0 $pid 2>/dev/null || break
	sleep 1
	i=$((i + 1))
done

wait $pid
rc=$?
report remove
exit $rc
